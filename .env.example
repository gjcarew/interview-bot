# LLM provider: "ollama" (default, runs locally) or "github" (GitHub Models)
LLM_PROVIDER=ollama

# ── Ollama ──────────────────────────────────────────────
# Install: brew install ollama && brew services start ollama
# Pull the model once: ollama pull qwen2.5:7b
LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# ── GitHub Models (set LLM_PROVIDER=github) ─────────────
# Fine-grained PAT: https://github.com/settings/tokens?type=beta
# Required permission: Account > Models > Read
# GITHUB_TOKEN=your_github_token_here
# GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
# INTERVIEW_MODEL=gpt-4o
